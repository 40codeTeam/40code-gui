          "contextLines": {"type": "integer", "minimum": 0, "maximum": 10, "default": 1},
          "cursor": {"type": "string", "minLength": 1, "maxLength": 2048},
          "maxChars": {"type": "integer", "minimum": 1, "maximum": 200000, "default": 48000}
        },
        "required": ["query"],
        "oneOf": [
          {"properties": {"scope": {"enum": ["all_targets"]}}, "not": {"required": ["targetRefs"]}},
          {"properties": {"scope": {"enum": ["current", "all_sprites"]}}, "required": ["scope"], "not": {"required": ["targetRefs"]}},
          {"properties": {"scope": {"enum": ["targets"]}}, "required": ["targetRefs"]}
