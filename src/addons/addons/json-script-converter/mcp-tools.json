    {
      "name": "edit_pseudocode",
      "description": "Replace or patch pseudocode. Read jsc://pseudocode/syntax first.",
      "annotations": {"readOnlyHint": false, "destructiveHint": true, "idempotentHint": false, "openWorldHint": false},
      "inputSchema": {
        "type": "object",
        "properties": {
          "targetRef": {"type": "string", "minLength": 1, "maxLength": 256},
          "mode": {"type": "string", "enum": ["replace", "patch"]},
          "pseudocode": {"type": "string", "maxLength": 4000000},
          "patches": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "object",
              "properties": {
                "op": {"type": "string", "enum": ["replace", "delete", "insertAfter"]},
                "startLine": {"type": "integer", "minimum": 1, "maximum": 1000000},
                "endLine": {"type": "integer", "minimum": 1, "maximum": 1000000},
                "afterLine": {"type": "integer", "minimum": 0, "maximum": 1000000},
                "oldText": {"type": "string", "maxLength": 4000000},
                "newText": {"type": "string", "maxLength": 4000000}
              },
              "oneOf": [
                {"properties": {"op": {"const": "replace"}}, "required": ["op", "startLine", "endLine", "oldText", "newText"], "not": {"required": ["afterLine"]}},
                {"properties": {"op": {"const": "delete"}}, "required": ["op", "startLine", "endLine", "oldText"], "not": {"anyOf": [{"required": ["afterLine"]}, {"required": ["newText"]}]}},
                {"properties": {"op": {"const": "insertAfter"}}, "required": ["op", "afterLine", "newText"], "not": {"anyOf": [{"required": ["startLine"]}, {"required": ["endLine"]}, {"required": ["oldText"]}]}}
              ],
              "additionalProperties": false
            }
          },
          "edits": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "targetRef": {"type": "string", "minLength": 1, "maxLength": 256},
                "mode": {"type": "string", "enum": ["replace", "patch"]},
                "pseudocode": {"type": "string", "maxLength": 4000000},
                "patches": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1000,
                  "items": {
                    "type": "object",
                    "properties": {
                      "op": {"type": "string", "enum": ["replace", "delete", "insertAfter"]},
                      "startLine": {"type": "integer", "minimum": 1, "maximum": 1000000},
                      "endLine": {"type": "integer", "minimum": 1, "maximum": 1000000},
                      "afterLine": {"type": "integer", "minimum": 0, "maximum": 1000000},
                      "oldText": {"type": "string", "maxLength": 4000000},
                      "newText": {"type": "string", "maxLength": 4000000}
                    },
                    "oneOf": [
                      {"properties": {"op": {"const": "replace"}}, "required": ["op", "startLine", "endLine", "oldText", "newText"], "not": {"required": ["afterLine"]}},
                      {"properties": {"op": {"const": "delete"}}, "required": ["op", "startLine", "endLine", "oldText"], "not": {"anyOf": [{"required": ["afterLine"]}, {"required": ["newText"]}]}},
                      {"properties": {"op": {"const": "insertAfter"}}, "required": ["op", "afterLine", "newText"], "not": {"anyOf": [{"required": ["startLine"]}, {"required": ["endLine"]}, {"required": ["oldText"]}]}}
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["targetRef", "mode"],
              "oneOf": [
                {"properties": {"mode": {"const": "replace"}}, "required": ["pseudocode"], "not": {"required": ["patches"]}},
                {"properties": {"mode": {"const": "patch"}}, "required": ["patches"], "not": {"required": ["pseudocode"]}}
              ],
              "additionalProperties": false
            }
          }
        },
        "oneOf": [
          {"properties": {"mode": {"const": "replace"}}, "required": ["targetRef", "mode", "pseudocode"], "not": {"anyOf": [{"required": ["patches"]}, {"required": ["edits"]}]}},
          {"properties": {"mode": {"const": "patch"}}, "required": ["targetRef", "mode", "patches"], "not": {"anyOf": [{"required": ["pseudocode"]}, {"required": ["edits"]}]}},
          {"required": ["edits"], "not": {"anyOf": [{"required": ["targetRef"]}, {"required": ["mode"]}, {"required": ["pseudocode"]}, {"required": ["patches"]}]}}
        ],
        "additionalProperties": false
      }
    }
  ]
