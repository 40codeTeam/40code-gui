    {
      "name": "get_pseudocode",
      "description": "Read pseudocode for the current target, selected targets, or all targets with cursor pagination. An empty object reads the current target.",
      "annotations": {"readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false},
      "inputSchema": {
        "type": "object",
        "properties": {
          "scope": {"type": "string", "enum": ["current", "targets", "all_sprites", "all_targets"], "default": "current"},
          "targetRefs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1, "maxLength": 256},
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "includeStage": {"type": "boolean", "default": false},
          "cursor": {"type": "string", "minLength": 1, "maxLength": 2048},
          "maxChars": {"type": "integer", "minimum": 1, "maximum": 200000, "default": 48000},
          "startLine": {"type": "integer", "minimum": 1, "maximum": 1000000},
          "endLine": {"type": "integer", "minimum": 1, "maximum": 1000000},
          "lineRanges": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "properties": {
                "targetRef": {"type": "string", "minLength": 1, "maxLength": 256},
                "startLine": {"type": "integer", "minimum": 1, "maximum": 1000000},
                "endLine": {"type": "integer", "minimum": 1, "maximum": 1000000}
              },
              "required": ["startLine", "endLine"],
              "additionalProperties": false
            }
          }
        },
        "dependencies": {"startLine": ["endLine"], "endLine": ["startLine"]},
        "allOf": [
          {
            "not": {
              "allOf": [
                {"required": ["lineRanges"]},
                {"anyOf": [{"required": ["startLine"]}, {"required": ["endLine"]}]}
              ]
            }
          }
        ],
        "oneOf": [
          {
            "properties": {"scope": {"enum": ["current"]}},
            "not": {"required": ["targetRefs"]}
          },
          {
            "properties": {"scope": {"enum": ["all_sprites", "all_targets"]}},
            "required": ["scope"],
            "not": {"required": ["targetRefs"]}
          },
          {
            "properties": {"scope": {"enum": ["targets"]}},
            "required": ["targetRefs"]
          }
        ],
        "additionalProperties": false
      }
    },
